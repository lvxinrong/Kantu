    "skipMarkers": ["<redacted", "已脱敏"],
    "patterns": [
      { "id": "FULL_HTTP_URL", "source": "https?://(?!<)[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z]{2,}(?:[/:][^\\s|`]*)?", "flags": "i" },
      { "id": "IPV4_ADDRESS", "source": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}(?::\\d+)?\\b", "flags": "i" },
      { "id": "CREDENTIAL_ASSIGNMENT", "source": "(?:api[ _-]?key|secret|client[ _-]?secret|password|token)\\s*[=:]\\s*[\\\"']?[A-Za-z0-9_./+-]{12,}", "flags": "i" },
      { "id": "PRIVATE_KEY", "source": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----", "flags": "i" },
      { "id": "JDBC_URL", "source": "jdbc:[a-z0-9]+://[^\\s|`]+", "flags": "i" }
    ]
  }
