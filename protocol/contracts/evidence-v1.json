      { "id": "EMBEDDED_URL_CREDENTIAL", "source": "(?:https?|jdbc:[a-z0-9]+)://[^/\\s:@]+:[^@\\s/]+@", "flags": "i" },
      { "id": "SECRET_XML_ELEMENT", "source": "<(?:password|passwd|secret|token|accessKey|secretKey)>[^<]{4,}</", "flags": "i" }
