      { "id": "PRIVATE_KEY", "source": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----", "flags": "i" },
      { "id": "JDBC_URL", "source": "jdbc:[a-z0-9]+://[^\\s|`]+", "flags": "i" },
      { "id": "BARE_INTERNAL_DOMAIN", "source": "(?<![A-Za-z0-9._-])(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:com|cn|net|org|io|cloud|corp|internal|local)(?::\\d+)?\\b", "flags": "i" },
      { "id": "RAW_DATA_ASSET_IDENTIFIER", "source": "(?:(?:数据库|数据表|库名|主库|会员库|Schema|Topic|Exchange|Queue|表族|事件表)[^\\n|]{0,80}\\b[a-z][a-z0-9]{2,}_[a-z][a-z0-9_]{2,}\\b|\\b[a-z][a-z0-9]{2,}_[a-z][a-z0-9_]{2,}\\b(?=[^\\n|]{0,40}(?:数据库|数据表|库|表|Schema|Topic|Exchange|Queue)))", "flags": "iu" }
    ]
  }
